{
  "uid": "aegisshop-slo",
  "title": "AegisShop SLO burn, observed demo windows",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Observed 5m request success, not uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1 - aegisshop:slo_error_ratio:5m",
          "legendFormat": "{{service}} / {{environment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5m error budget burn, 99.9% demo objective",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "aegisshop:slo_burn_rate:5m",
          "legendFormat": "{{service}} / {{environment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "1h error budget burn, 99.9% demo objective",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "aegisshop:slo_burn_rate:1h",
          "legendFormat": "{{service}} / {{environment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Observed request traffic, zero traffic has no SLO verdict",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service, environment) (rate(http_server_requests_total{service=~\"catalog-service|cart-service|order-service|payment-service\"}[5m]))",
          "legendFormat": "{{service}} / {{environment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "text",
      "title": "Measurement limits",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "options": {
        "mode": "markdown",
        "content": "Versioned demo request-success objective: 99.9%. Independent of editable registry objectives. These are observed rolling-window ratios, not a 30-day budget remaining or uptime claim. Missing/zero traffic is not healthy. A short-lived stack cannot establish a complete 1-hour window. Fast-burn alert requires both windows above 14.4x for 2m. No action is authorized by an alert."
      }
    }
  ],
  "tags": [
    "aegisshop",
    "slo"
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
