# AegisSRE local development environment (copy to .env and adjust)

# ── Data layer ────────────────────────────────────────────────
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegissre

# ── Observability ─────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=aegis

# Platform metadata database (URL-encode special characters in credentials).
# Keep this consistent with the Postgres user, password and database above.
PLATFORM_DATABASE_URL=postgresql+psycopg://aegis:aegis@postgres:5432/aegissre

# Required for the reliability API. Supply a long random token via a local
# untracked environment file or a secret manager. There is no default token.
AEGIS_API_TOKEN=
AEGIS_DEV_MODE=false
AEGIS_POLL_SECONDS=15

# Fresh stacks use pgvector. Read docs/operations/knowledge.md before reusing
# an older PostgreSQL volume or changing the database image.
AEGIS_KNOWLEDGE_ENABLED=true
# To retain an older image during migration, override AEGIS_POSTGRES_IMAGE
# and set AEGIS_KNOWLEDGE_ENABLED=false until the extension is available.

# Distinct internal metadata credentials. Neither is the console/gateway token.
# The collector/indexer receive only READ; the gateway holds the write key.
AEGIS_METADATA_API_TOKEN=
AEGIS_METADATA_READ_TOKEN=

# Required for encrypted console sessions. Use a separate random value of at
# least32 characters, not an API token. Keep this file copy untracked in .env.
AEGIS_CONSOLE_SESSION_SECRET=
