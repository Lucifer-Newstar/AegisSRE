# AegisSRE local development environment (copy to .env and adjust)

# ── Data layer ────────────────────────────────────────────────
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegissre

# ── Observability ─────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=aegis

# Platform metadata database (URL-encode special characters in credentials).
# Keep this consistent with the Postgres user, password and database above.
PLATFORM_DATABASE_URL=postgresql+psycopg://aegis:aegis@postgres:5432/aegissre

# Required for the reliability API. Supply a long random token via a local
# untracked environment file or a secret manager. There is no default token.
AEGIS_API_TOKEN=
AEGIS_DEV_MODE=false
AEGIS_POLL_SECONDS=15
